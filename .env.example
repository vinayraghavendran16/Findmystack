# Copy to .env and fill in.
# The app runs without these, but confirmations will be marked "unverified"
# and search providers that need auth will stay disabled.

# Verifier
ANTHROPIC_API_KEY=

# Web / news / job-postings search (pick one; leave others blank)
SERPER_API_KEY=
TAVILY_API_KEY=

# Optional providers
YOUTUBE_API_KEY=
PROXYCURL_API_KEY=

# Storage
DATABASE_URL=sqlite:///./findmystack.db
